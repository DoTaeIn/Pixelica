cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/PixelicaWorkDir.cmake")
pixelica_make_run_dir("${PIXELICA_BINARY_DIR}" "${PIXELICA_SOURCE_DIR}"
                     "${PIXELICA_SDK_WORK_DIR}" particles_work)
set(particles_config "${PIXELICA_CONFIG}")
if(particles_config STREQUAL "")
  set(particles_config Release)
endif()
function(particles_step)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Particles SDK check failed (${rc})\n${out}\n${err}")
  endif()
endfunction()
set(particles_prefix "${particles_work}/prefix")
set(particles_components common particles)
if(PIXELICA_EXPECT_2D)
  list(APPEND particles_components renderer2d particles2d)
endif()
if(PIXELICA_EXPECT_HYBRID)
  list(APPEND particles_components core hybrid particles25d)
endif()
foreach(component IN LISTS particles_components)
  particles_step("${CMAKE_COMMAND}" --install "${PIXELICA_BINARY_DIR}" --config "${particles_config}"
             --prefix "${particles_prefix}" --component "${component}")
endforeach()
# Copy the consumer to ensure it uses only the installed public package.
file(COPY "${PIXELICA_SOURCE_DIR}/cmake/ParticlesConsumer/" DESTINATION "${particles_work}/consumer")
set(particles_args -G "${PIXELICA_SDK_GENERATOR}" "-DCMAKE_BUILD_TYPE=${particles_config}"
  "-DPixelica_DIR=${particles_prefix}/${PIXELICA_INSTALL_CMAKEDIR}"
  "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF" "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF")
if(NOT "${PIXELICA_SDK_PLATFORM}" STREQUAL "")
  list(APPEND particles_args -A "${PIXELICA_SDK_PLATFORM}")
endif()
if(NOT "${PIXELICA_SDK_TOOLSET}" STREQUAL "")
  list(APPEND particles_args -T "${PIXELICA_SDK_TOOLSET}")
endif()
if(NOT PIXELICA_SDK_GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
  if(NOT "${PIXELICA_SDK_C_COMPILER}" STREQUAL "")
    list(APPEND particles_args "-DCMAKE_C_COMPILER=${PIXELICA_SDK_C_COMPILER}")
  endif()
  if(NOT "${PIXELICA_SDK_MAKE_PROGRAM}" STREQUAL "")
    list(APPEND particles_args "-DCMAKE_MAKE_PROGRAM=${PIXELICA_SDK_MAKE_PROGRAM}")
  endif()
endif()
foreach(component IN LISTS particles_components)
  if(NOT component MATCHES "^particles(2d|25d)?$")
    continue()
  endif()
  particles_step("${CMAKE_COMMAND}" -S "${particles_work}/consumer"
    -B "${particles_work}/build-${component}" ${particles_args}
    "-DPARTICLES_COMPONENT=${component}")
  particles_step("${CMAKE_COMMAND}" --build "${particles_work}/build-${component}"
    --config "${particles_config}" --parallel 2)
  particles_step("${CMAKE_CTEST_COMMAND}" --test-dir "${particles_work}/build-${component}"
    -C "${particles_config}" --output-on-failure)
endforeach()
