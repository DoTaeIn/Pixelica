cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/PixelicaWorkDir.cmake")
pixelica_make_run_dir("${PIXELICA_BINARY_DIR}" "${PIXELICA_SOURCE_DIR}"
                     "${PIXELICA_SDK_WORK_DIR}" shaders_work)
set(shaders_config "${PIXELICA_CONFIG}")
if(shaders_config STREQUAL "")
  set(shaders_config Release)
endif()
function(shaders_step)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Shaders SDK check failed (${rc})\n${out}\n${err}")
  endif()
endfunction()
set(shaders_prefix "${shaders_work}/prefix")
foreach(component common shaders)
  shaders_step("${CMAKE_COMMAND}" --install "${PIXELICA_BINARY_DIR}" --config "${shaders_config}"
    --prefix "${shaders_prefix}" --component "${component}")
endforeach()
file(COPY "${PIXELICA_SOURCE_DIR}/cmake/ShadersConsumer/" DESTINATION "${shaders_work}/consumer")
set(shaders_args -G "${PIXELICA_SDK_GENERATOR}" "-DCMAKE_BUILD_TYPE=${shaders_config}"
  "-DCMAKE_PREFIX_PATH=${shaders_prefix}"
  "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF" "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF")
if(NOT "${PIXELICA_SDK_PLATFORM}" STREQUAL "")
  list(APPEND shaders_args -A "${PIXELICA_SDK_PLATFORM}")
endif()
if(NOT "${PIXELICA_SDK_TOOLSET}" STREQUAL "")
  list(APPEND shaders_args -T "${PIXELICA_SDK_TOOLSET}")
endif()
if(NOT PIXELICA_SDK_GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
  if(NOT "${PIXELICA_SDK_C_COMPILER}" STREQUAL "")
    list(APPEND shaders_args "-DCMAKE_C_COMPILER=${PIXELICA_SDK_C_COMPILER}")
  endif()
  if(NOT "${PIXELICA_SDK_MAKE_PROGRAM}" STREQUAL "")
    list(APPEND shaders_args "-DCMAKE_MAKE_PROGRAM=${PIXELICA_SDK_MAKE_PROGRAM}")
  endif()
endif()
shaders_step("${CMAKE_COMMAND}" -S "${shaders_work}/consumer"
  -B "${shaders_work}/build" ${shaders_args})
shaders_step("${CMAKE_COMMAND}" --build "${shaders_work}/build" --config "${shaders_config}" --parallel 2)
shaders_step("${CMAKE_CTEST_COMMAND}" --test-dir "${shaders_work}/build"
  -C "${shaders_config}" --output-on-failure)
