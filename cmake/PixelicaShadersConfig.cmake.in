@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Pixelica @PROJECT_VERSION@ CONFIG COMPONENTS common)
if(NOT TARGET Pixelica::shaders)
  include("${CMAKE_CURRENT_LIST_DIR}/PixelicaShadersTargets.cmake")
  set_property(TARGET Pixelica::shaders APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Pixelica::common)
endif()
check_required_components(PixelicaShaders)
