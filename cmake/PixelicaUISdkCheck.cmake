cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/PixelicaWorkDir.cmake")
pixelica_make_run_dir("${PIXELICA_BINARY_DIR}" "${PIXELICA_SOURCE_DIR}"
                     "${PIXELICA_SDK_WORK_DIR}" ui_work)
set(ui_config "${PIXELICA_CONFIG}")
if(ui_config STREQUAL "")
  set(ui_config Release)
endif()
function(ui_step)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "UI SDK check failed (${rc})\n${out}\n${err}")
  endif()
endfunction()
set(ui_prefix "${ui_work}/prefix")
foreach(component common)
  ui_step("${CMAKE_COMMAND}" --install "${PIXELICA_BINARY_DIR}" --config "${ui_config}"
    --prefix "${ui_prefix}" --component "${component}")
endforeach()
file(COPY "${PIXELICA_SOURCE_DIR}/cmake/UIConsumer/" DESTINATION "${ui_work}/consumer")
set(ui_args -G "${PIXELICA_SDK_GENERATOR}" "-DCMAKE_BUILD_TYPE=${ui_config}"
  "-DCMAKE_PREFIX_PATH=${ui_prefix}"
  "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF" "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF")
if(NOT "${PIXELICA_SDK_PLATFORM}" STREQUAL "")
  list(APPEND ui_args -A "${PIXELICA_SDK_PLATFORM}")
endif()
if(NOT "${PIXELICA_SDK_TOOLSET}" STREQUAL "")
  list(APPEND ui_args -T "${PIXELICA_SDK_TOOLSET}")
endif()
if(NOT PIXELICA_SDK_GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
  if(NOT "${PIXELICA_SDK_C_COMPILER}" STREQUAL "")
    list(APPEND ui_args "-DCMAKE_C_COMPILER=${PIXELICA_SDK_C_COMPILER}")
  endif()
  if(NOT "${PIXELICA_SDK_MAKE_PROGRAM}" STREQUAL "")
    list(APPEND ui_args "-DCMAKE_MAKE_PROGRAM=${PIXELICA_SDK_MAKE_PROGRAM}")
  endif()
endif()
ui_step("${CMAKE_COMMAND}" -S "${ui_work}/consumer"
  -B "${ui_work}/build" ${ui_args})
ui_step("${CMAKE_COMMAND}" --build "${ui_work}/build" --config "${ui_config}" --parallel 2)
ui_step("${CMAKE_CTEST_COMMAND}" --test-dir "${ui_work}/build"
  -C "${ui_config}" --output-on-failure)
